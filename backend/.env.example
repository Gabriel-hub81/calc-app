# Copia este archivo a .env y llena los valores reales.
# .env está en .gitignore — NUNCA lo commitees.
# En producción (Cloud Run) la key vive en Google Cloud Secret Manager, no aquí.

GEMINI_API_KEY=your_gemini_api_key_here

# Modelo vigente — verifica en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash

PORT=8080
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Capa 1.5 — persistencia y auth
# STORE: memory (desarrollo/tests, sin credenciales) | firestore (producción)
STORE=memory
# AUTH_MODE: dev (token "dev:<uid>", solo desarrollo) | privy (producción)
AUTH_MODE=dev
# Para AUTH_MODE=privy: el App ID de Privy (público — el mismo del frontend).
# La verificación usa el JWKS público de Privy; NO se necesita el App Secret.
# PRIVY_APP_ID=your_privy_app_id
# Para STORE=firestore: el proyecto de Google Cloud (y credenciales ADC)
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# Sesión 2 — Solana (verificación on-chain OPCIONAL; sin esto, /verify devuelve
# el hash con registro_pendiente y el cálculo sigue siendo válido)
# CALC_PROGRAM_ID=Gh3WhpAtc8HDUUU59amgzaxvg4nCV3V4pSN3EntBHwRL
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_CLUSTER=devnet
# Modo devnet/demo: el backend firma con este keypair. En producción firma el
# usuario desde su wallet embebido (Sesión 3) — no-custodial.
# SOLANA_KEYPAIR_PATH=/path/to/devnet-keypair.json
